{
  "output_dir": "outputs_subgroups/run_all",
  "static_config": "configs/subgroup_pipelines.json",
  "static_datasets": [ "insurance", "sklearn_california_housing" ],
  "longitudinal_datasets": [
    {
      "name": "wbd",
      "path": "wbd/world_bank_development_indicators.csv",
      "id_col": "country",
      "date_col": "date",
      "target": "life_expectancy_at_birth",
      "mode": "snapshot",
      "panel_stride": 1,
      "window_size": 5,          
      "min_history": 3,          
      "max_missing_frac": 0.5,
      "impute_missing": true,
      "target_modes": ["value", "trend"],
      "xgboost": { "enabled": true }
    }
  ]
}