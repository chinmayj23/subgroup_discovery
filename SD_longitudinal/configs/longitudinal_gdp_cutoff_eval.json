{
  "datasets": [
    {
      "name": "wbd",
      "path": "wbd/world_bank_development_indicators.csv",
      "id_col": "country",
      "date_col": "date",
      "target": "life_expectancy_at_birth",
      "enabled": true,
      "run_standard_pipelines": false,
      "max_missing_frac": 0.95,
      "impute_missing": true,
      "include_target_features": false,
      "min_history": 0,
      "label_window": 5,
      "question_pack": {
        "lags": [5, 7, 10],
        "windows": [3, 5, 7, 10],
        "include_pct_change": true,
        "include_volatility": true
      },
      "cutoff_growth_eval": {
        "enabled": true,
        "name": "gdp_per_capita_growth_cutoff_eval",
        "gdp_col": "GDP_current_US",
        "population_col": "population",
        "feature_target_col": "gdp_per_capita",
        "growth_start_year": 2010,
        "growth_end_year": 2020,
        "interesting_quantile": 0.9,
        "cutoff_years": [1980, 1990, 2000, 2010],
        "mode": "snapshot",
        "min_history": 0,
        "label_window": 5,
        "max_missing_frac": 0.95,
        "test_size": 0.25,
        "split_seed": 42,
        "split_country_pool": "available_all_cutoffs",
        "enforce_min_history": false,
        "snapshot_constant_rows": true,
        "strict_country_split": true,
        "min_train_rows": 30,
        "min_test_rows": 20,
        "min_train_positives": 2,
        "min_test_positives": 2,
        "include_target_features": false,
        "question_pack": {
          "lags": [5, 7, 10, 15, 20, 30, 40],
          "windows": [3, 5, 7, 10, 15, 20, 30, 40],
          "include_pct_change": true,
          "include_volatility": true
        },
        "forest_overrides": {
          "n_seeds": 500,
          "accuracy_quantile": 0.99,
          "min_trees": 1,
          "max_trees": 10,
          "min_questions": 2,
          "max_questions": 10,
          "n_jobs": 1
        }
      }
    }
  ],
  "pipelines": {
    "tail_cluster": {
      "high_value_quantile": 0.99,
      "two_tailed": true
    },
    "timetribes": {
      "n_seeds": 1000,
      "beta": 0.5,
      "lambd_div": 2.0,
      "top_percentile": 0.005,
      "max_overlap": 0.9,
      "min_subgroup_size": 10,
      "max_subgroup_frac": 0.3
    }
  },
  "forest": {
    "n_seeds": 1000,
    "accuracy_quantile": 0.99,
    "min_trees": 1,
    "max_trees": 10,
    "min_questions": 2,
    "max_questions": 10,
    "test_size": 0.2,
    "vote_rule": "any",
    "eval_mode": "train",
    "n_jobs": 1
  }
}
